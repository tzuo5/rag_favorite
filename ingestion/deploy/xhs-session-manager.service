[Unit]
Description=Xiaohongshu persistent session refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/AI-Video-Transcriber
EnvironmentFile=/home/ubuntu/AI-Video-Transcriber/.env
EnvironmentFile=-/home/ubuntu/.openclaw/.env
ExecStart=/usr/bin/xvfb-run -a /home/ubuntu/AI-Video-Transcriber/.venv/bin/python -m backend.xhs_session.cli refresh
SuccessExitStatus=4
TimeoutStartSec=7min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/share/xhs-session /home/ubuntu/AI-Video-Transcriber/secrets
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

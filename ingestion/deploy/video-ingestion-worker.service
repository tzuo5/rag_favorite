[Unit]
Description=Telegram video knowledge ingestion worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/AI-Video-Transcriber
EnvironmentFile=/home/ubuntu/AI-Video-Transcriber/.env
EnvironmentFile=/home/ubuntu/.openclaw/.env
ExecStart=/home/ubuntu/AI-Video-Transcriber/.venv/bin/python -m backend.ingestion.cli worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
Nice=10
CPUQuota=180%
MemoryHigh=3G
MemoryMax=4G
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/AI-Video-Transcriber/temp /home/ubuntu/AI-Video-Transcriber/staging /home/ubuntu/知识库 /home/ubuntu/.openclaw/media/inbound
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

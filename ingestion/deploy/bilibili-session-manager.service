[Unit]
Description=Bilibili QR login and cookie refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@INGESTION_DIR@
EnvironmentFile=@INGESTION_DIR@/.env
EnvironmentFile=-@OPENCLAW_ENV@
ExecStart=@INGESTION_DIR@/.venv/bin/python -m backend.bilibili_session.cli login
SuccessExitStatus=4
TimeoutStartSec=4min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@PRODUCT_DATA_DIR@/sessions/bilibili @INGESTION_DIR@/secrets
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

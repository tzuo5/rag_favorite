[Unit]
Description=Telegram video batch notification outbox worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/AI-Video-Transcriber
EnvironmentFile=/home/ubuntu/AI-Video-Transcriber/.env
EnvironmentFile=/home/ubuntu/.openclaw/.env
ExecStart=/home/ubuntu/AI-Video-Transcriber/.venv/bin/python -m backend.ingestion.cli batch-notification-worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/AI-Video-Transcriber

[Install]
WantedBy=default.target

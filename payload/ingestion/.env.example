# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI Base URL (for proxy or alternative endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000

# Whisper Model Configuration (Optional)
# Options: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_NUM_WORKERS=1
WHISPER_BEAM_SIZE=1

# Telegram is consumed by OpenClaw. The worker only uses this token for outbound
# notifications; keep it in a secret env file and never commit it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

YTDLP_COOKIES_FILE=
# Dedicated Bilibili cookie file written by the QR session manager.
BILIBILI_COOKIES_FILE=
BILIBILI_SESSION_ENABLED=false
# Optional; defaults to the rag-favorite XDG data directory.
BILIBILI_SESSION_ROOT=
BILIBILI_LOGIN_TIMEOUT_SECONDS=180
BILIBILI_QR_TTL_SECONDS=180
BILIBILI_AUTO_RESUME=true
BILIBILI_LOGIN_CHAT_IDS=
# Optional dedicated Xiaohongshu Netscape/JSON cookie export. Falls back to
# YTDLP_COOKIES_FILE. Required for signed author pagination beyond the public
# profile's server-rendered first page; keep this file mode 0600.
XIAOHONGSHU_COOKIES_FILE=
# Persistent Chromium session manager. Keep disabled until Playwright Chromium
# and Xvfb are installed and the user units in deploy/ are enabled.
XIAOHONGSHU_SESSION_ENABLED=false
# Optional; defaults to the rag-favorite XDG data directory.
XIAOHONGSHU_SESSION_ROOT=
XIAOHONGSHU_SESSION_PROBE_MAX_AGE_SECONDS=900
XIAOHONGSHU_LOGIN_TIMEOUT_SECONDS=180
XIAOHONGSHU_QR_TTL_SECONDS=300
XIAOHONGSHU_AUTO_RESUME=true
# Comma-separated private Telegram chat IDs that may receive login QR images.
# Defaults to TELEGRAM_ALLOWED_USER_IDS when omitted.
XIAOHONGSHU_LOGIN_CHAT_IDS=
YTDLP_YOUTUBE_PLAYER_CLIENT=mweb
YTDLP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36"
MAX_FILE_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=14400
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=21600
TEMP_FILE_TTL_HOURS=24
MAX_JOB_RETRIES=2
JOB_RETRY_DELAY_SECONDS=60

# Author batch ingestion is fail-closed. I1 only installs schema and types;
# discovery and execution remain disabled until their later rollout gates pass.
AUTHOR_BATCH_YOUTUBE_DISCOVERY_ENABLED=false
AUTHOR_BATCH_YOUTUBE_EXECUTION_ENABLED=false
AUTHOR_BATCH_BILIBILI_ENABLED=false
AUTHOR_BATCH_XIAOHONGSHU_ENABLED=false
AUTHOR_DISCOVERY_SCAN_LIMIT=50
AUTHOR_BATCH_MAX_ITEMS=50
AUTHOR_DISCOVERY_PREVIEW_TTL_MINUTES=30
MAX_BATCH_ESTIMATED_DURATION_SECONDS=43200
ENFORCE_BATCH_ESTIMATED_DURATION_BUDGET=false
MAX_BATCH_UNKNOWN_DURATION_RESERVATION_SECONDS=3600
BATCH_NOTIFICATION_ITEM_THRESHOLD=5
BATCH_NOTIFICATION_INTERVAL_SECONDS=600
BATCH_CHILD_PRIORITY_WAIT_SECONDS=1800
MIN_DISK_FREE_GB=5
YOUTUBE_REQUEST_MIN_INTERVAL_SECONDS=5
YOUTUBE_REQUEST_JITTER_SECONDS=3
YOUTUBE_RATE_LIMIT_BACKOFF_SECONDS=900
BILIBILI_REQUEST_MIN_INTERVAL_SECONDS=10
BILIBILI_REQUEST_JITTER_SECONDS=5
BILIBILI_RATE_LIMIT_BACKOFF_SECONDS=1800
XIAOHONGSHU_REQUEST_MIN_INTERVAL_SECONDS=15
XIAOHONGSHU_REQUEST_JITTER_SECONDS=10
XIAOHONGSHU_RATE_LIMIT_BACKOFF_SECONDS=3600
PLATFORM_FAILURE_THRESHOLD=3
PLATFORM_FAILURE_WINDOW_SECONDS=600
PLATFORM_MAX_BACKOFF_SECONDS=21600
AUTHOR_DISCOVERY_STALE_SECONDS=300

# Optional path overrides. Leave empty to use the shared product configuration.
VIDEO_TEMP_ROOT=
VIDEO_STAGING_ROOT=
MAIN_KB_MARKDOWN_DIR=
COOKING_KB_MARKDOWN_DIR=
VIDEO_DB_ENV=
COOKING_INGEST_ENV=
OPENCLAW_MEDIA_ROOT=

# Optional OpenAI-compatible metadata enrichment. Without these, the validated
# deterministic fallback is used and the full transcript is still preserved.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Local upload size limit in MB (optional; Docker Compose passes this through)
UPLOAD_MAX_MB=200

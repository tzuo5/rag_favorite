# Phase 1 connection template. Fill credentials locally, never commit them.
# CCR is not installed on the current host. Confirm its project and actual endpoint.
OPENAI_API_STYLE=responses
OPENAI_BASE_URL=http://127.0.0.1:3456/v1
OPENAI_MODEL=Codex API/gpt-6-luna
OPENAI_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
VIDEO_ASR_BACKEND=openrouter
VIDEO_ASR_MODEL=qwen/qwen3-asr-0.6b
VIDEO_ASR_COARSE_CHUNK_SECONDS=30
VIDEO_CLOUD_MAX_COST_USD=0.03

# The real vision provider is Phase 2; keep it disabled until acceptance.
VIDEO_VISUAL_ENABLED=false
VIDEO_VISUAL_ALLOWED_CATEGORIES=cooking
MAX_CONCURRENT_JOBS=1

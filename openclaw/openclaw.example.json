{
  "agents": {
    "defaults": {
      "workspace": "<workspace>",
      "memorySearch": {
        "enabled": true,
        "provider": "ollama",
        "model": "qwen3-embedding:0.6b",
        "fallback": "none",
        "remote": {
          "baseUrl": "http://127.0.0.1:11434",
          "apiKey": "ollama-local",
          "nonBatchConcurrency": 1
        },
        "chunking": {
          "tokens": 400,
          "overlap": 80
        },
        "sync": {
          "onSessionStart": true,
          "onSearch": true,
          "watch": true,
          "watchDebounceMs": 1500,
          "embeddingBatchTimeoutSeconds": 600
        },
        "query": {
          "maxResults": 6,
          "minScore": 0.35,
          "hybrid": {
            "enabled": true,
            "vectorWeight": 0.7,
            "textWeight": 0.3,
            "candidateMultiplier": 4
          }
        }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "<gateway-token>"
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "video-knowledge-ingest": {
        "enabled": true,
        "config": {
          "python": "<repo>/ingestion/.venv/bin/python",
          "projectDir": "<repo>/ingestion"
        },
        "hooks": {
          "allowConversationAccess": true
        }
      }
    },
    "load": {
      "paths": [
        "<repo>/ingestion/openclaw-plugin"
      ]
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": {
        "source": "env",
        "id": "TELEGRAM_BOT_TOKEN"
      },
      "dmPolicy": "allowlist",
      "groupPolicy": "disabled",
      "allowFrom": [
        "<telegram-user-id>"
      ]
    }
  },
  "mcp": {
    "servers": {
      "rag-favorite": {
        "enabled": true,
        "command": "<venv>/bin/python",
        "args": [
          "-m",
          "rag_favorite.mcp_server"
        ],
        "env": {
          "RAG_FAVORITE_CONFIG": "<config>/rag-favorite/config.toml",
          "RAG_FAVORITE_OPENCLAW_MANAGED": "1"
        },
        "transport": "stdio",
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 180000,
        "supportsParallelToolCalls": true,
        "toolFilter": {
          "include": [
            "rag_search",
            "rag_status"
          ]
        }
      },
      "cooking-rag": {
        "command": "<repo>/services/cooking-rag/.venv/bin/python",
        "args": [
          "<repo>/services/cooking-rag/mcp_server.py"
        ],
        "cwd": "<repo>/services/cooking-rag",
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 180000,
        "toolFilter": {
          "include": [
            "cooking_recipe_create",
            "cooking_recipe_search",
            "cooking_recipe_get",
            "cooking_rag_status"
          ]
        }
      }
    }
  }
}
